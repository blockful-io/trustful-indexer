NODE_ENV=mainnet
# Soroban RPC retains only ~7 days of ledgers. Indexer was offline long enough
# that the old START_BLOCK (58333000) fell out of the retention window.
# 62530000 sits ~50k ledgers behind the chain head, leaving ~3 days of cushion
# for the indexer to catch up before the lower edge moves past.
# NOTE: applying this on Railway also requires updating _metadata.lastProcessedHeight
# in the existing Postgres DB (see commit message / runbook).
START_BLOCK=62530000
CHAIN_ID="Public Global Stellar Network ; September 2015"
SCORER_FACTORY_CONTRACT_ID=CBVQVSWZWDTIPJ46A6U7KIHTEP7PHRL5ZG5LNRKHO5OAV2CHNXVY5D2R

SOROBAN_ENDPOINT="https://soroban-rpc.mainnet.stellar.gateway.fm"
