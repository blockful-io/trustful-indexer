{
  "name": "test1",
  "version": "0.0.1",
  "description": "This project can be use as a starting point for developing your new Stellar Soroban SubQuery project",
  "main": "dist/index.js",
  "scripts": {
    "prebuild": "ts-node -e \"require('fs').writeFileSync('project.yaml', '# // Auto-generated , DO NOT EDIT\\n' + require('yaml').stringify(require('./project').default))\"",
    "build": "subql codegen && subql build",
    "codegen": "subql codegen",
    "test": "jest",
    "clean": "rm -rf dist .data",
    "clean:all": "yarn clean && rm -rf node_modules",
    "docker:up": "docker-compose -f docker/docker-compose.yml up -d",
    "docker:down": "docker-compose -f docker/docker-compose.yml down",
    "docker:logs": "docker-compose -f docker/docker-compose.yml logs -f --tail=100",
    "docker:build": "docker-compose -f docker/docker-compose.yml build",
    "docker:restart": "yarn docker:down && yarn docker:up",
    "dev": "yarn build && yarn docker:up && yarn docker:logs",
    "start": "yarn docker:up",
    "stop": "yarn docker:down",
    "logs": "yarn docker:logs"
  },
  "homepage": "https://github.com/subquery/stellar-subql-starter",
  "repository": "github:subquery/stellar-subql-starter",
  "files": [
    "dist",
    "schema.graphql",
    "project.yaml"
  ],
  "author": "SubQuery Team",
  "license": "MIT",
  "dependencies": {
    "@stellar/stellar-sdk": "latest",
    "@subql/common": "latest",
    "@subql/types-stellar": "latest",
    "@types/node": "^16.0.0",
    "typeorm": "^0.3.20"
  },
  "devDependencies": {
    "@subql/cli": "latest",
    "@subql/testing": "latest",
    "@subql/types": "latest",
    "dotenv": "latest",
    "dotenv-cli": "^8.0.0",
    "typescript": "latest"
  }
}
